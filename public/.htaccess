# OMAK RAYONNAGE — hébergement mutualisé Apache / cPanel
# Le site est un export statique de Next.js : /fr/, /en/, /ar/ + contact.php

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS + www -> non-www (adapter si le domaine doit garder le www) ---
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Racine -> version française ---
  RewriteRule ^$ /fr/ [L,R=302]

  # --- Anciennes URLs WordPress (indexées par Google) -> nouvelles pages ---
  # À garder : sans ces règles, les liens déjà référencés renvoient une 404.
  RedirectMatch 301 ^/accueil/qui-sommes-nous/?$            /fr/about/
  RedirectMatch 301 ^/accueil/contact/?$                    /fr/contact/
  RedirectMatch 301 ^/accueil/services/?$                   /fr/services/
  RedirectMatch 301 ^/accueil/services/etude-et-conception/?$      /fr/services/etude-conception/
  RedirectMatch 301 ^/accueil/services/installation-et-montage/?$  /fr/services/installation-montage/
  RedirectMatch 301 ^/accueil/services/controle-des-installations/?$ /fr/services/controle-installations/
  RedirectMatch 301 ^/accueil/services/service-apres-vente/?$      /fr/services/service-apres-vente/
  RedirectMatch 301 ^/accueil/services/pre-construction/?$         /fr/services/
  RedirectMatch 301 ^/accueil/produits/rayonnage-lourd/?$          /fr/produits/rayonnage-lourd/
  RedirectMatch 301 ^/accueil/produits/rayonnage-lourd-leger/?$    /fr/produits/semi-lourd-leger/
  RedirectMatch 301 ^/accueil/produits/plateforme-de-stockage/?$   /fr/produits/plateformes-stockage/
  RedirectMatch 301 ^/accueil/produits/mainutention-et-securite/?$ /fr/produits/protection-securite/
  RedirectMatch 301 ^/accueil/produits/accessoires/?$              /fr/produits/accessoires-manutention/
  RedirectMatch 301 ^/accueil/produits/cantilever/?$               /fr/produits/cantilever/
  RedirectMatch 301 ^/accueil/?$                                   /fr/

  # --- Anciennes URLs sans préfixe (/contact -> /fr/contact/) ---
  # On ne touche ni aux fichiers/dossiers réels, ni aux langues, ni au PHP.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(fr|en|ar)(/|$)
  RewriteCond %{REQUEST_URI} !^/_next/
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ /fr/$1 [L,R=301]
</IfModule>

# --- Page 404 générée par Next.js ---
ErrorDocument 404 /fr/404.html

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Cache : les assets Next ont un hash dans le nom, on peut cacher longtemps ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|otf|jpg|jpeg|png|webp|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
